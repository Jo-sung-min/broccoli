<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.project.broccoli.mapper.MemberMapper">

    <select id="findLoginInfo" resultType="com.project.broccoli.domain.UserInfo">
        SELECT * FROM tb_sso_user_sync
    </select>


    <select id="findUserLoginCheckPwd" resultType="com.project.broccoli.domain.UserInfo">
        SELECT
            USER_ID as userID
        FROM
            tb_sso_user_sync
        WHERE
            USER_ID =#{userId}
    </select>

</mapper>
